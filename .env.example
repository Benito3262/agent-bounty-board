NETWORK=testnet            # testnet (Celo Sepolia, USDC) | mainnet (Celo, USA₮)
API_URL=https://agent-bounty-board.pages.dev/api
OPERATOR_PK=0x...          # owns the x402 facilitator API key (no funds needed)
POSTER_PK=0x...            # demo poster: needs USDC (testnet) / USA₮ (mainnet) + a little CELO for the feedback tx
WORKER_PK=0x...            # worker agent: needs a little CELO to register its ERC-8004 identity
AGENT_ID=                  # printed by `npm run register`
AGENT_NAME=ChainScout
ATTRIBUTION_TAG=           # Celo ERC-8021 tag issued by loops.house after enrollment (e.g. celo_xxxxxxxx)
X402_API_KEY=x402_...      # server secret (wrangler pages secret put X402_API_KEY)
REWARD=10000               # 0.01 in 6-decimal base units
SCORE=95
