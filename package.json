    "@x402/evm": "^2.29.0",
    "@x402/fetch": "^2.29.0",
    "@x402/hono": "^2.29.0",
    "dompurify": "^3.4.17",
    "dotenv": "^18.0.9",
    "hono": "^4.13.14",
    "marked": "^18.1.2",
